{
  "kind": "collectionType",
  "collectionName": "districts",
  "info": {
    "singularName": "district",
    "pluralName": "districts",
    "displayName": "district"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "number": {
      "type": "integer",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "description": {
      "type": "blocks"
    },
    "map": {
      "allowedTypes": [
        "images"
      ],
      "type": "media",
      "multiple": false
    },
    "chairpersons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::team-member.team-member",
      "inversedBy": "districts"
    },
    "choirs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::choir.choir",
      "mappedBy": "district"
    }
  }
}
